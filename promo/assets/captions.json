[
  { "start": 0.314333, "end": 2.103583, "text": "Your next great idea shouldn't have" },
  { "start": 2.118583, "end": 3.2245410000000003, "text": "to wait for your keyboard." },
  { "start": 3.533666, "end": 5.0523739999999995, "text": "What if your words could simply flow?" },
  { "start": 7.3143329999999995, "end": 8.066499, "text": "Meet Reflow." },
  { "start": 8.387458, "end": 10.766333, "text": "Private, on-device dictation that turns" },
  { "start": 10.781333, "end": 12.039915999999998, "text": "the way you speak into the" },
  { "start": 12.054915999999999, "end": 13.113666, "text": "words you want to write." },
  { "start": 14.337916, "end": 15.184457, "text": "Hold your shortcut." },
  { "start": 15.493583000000001, "end": 16.387248999999997, "text": "Speak naturally." },
  { "start": 16.708208, "end": 17.436791, "text": "Then release." },
  { "start": 17.745958, "end": 19.959708, "text": "Reflow transcribes your words and inserts" },
  {
    "start": 19.974708,
    "end": 21.646707999999997,
    "text": "them into the app you're already using."
  },
  { "start": 21.955833000000002, "end": 22.825958, "text": "Stay with the thought." },
  { "start": 23.135083, "end": 23.816541, "text": "Keep your flow." },
  { "start": 25.314332999999998, "end": 27.163207999999997, "text": "Leave the ums, repetitions," },
  { "start": 27.260082999999998, "end": 28.590081999999995, "text": "and rough edges behind." },
  { "start": 28.89925, "end": 30.605957999999998, "text": "Choose a light cleanup, or use a" },
  {
    "start": 30.620957999999998,
    "end": 32.670291,
    "text": "local language model to polish grammar"
  },
  {
    "start": 32.79075,
    "end": 35.099540999999995,
    "text": "and shape longer thoughts into clear paragraphs."
  },
  { "start": 36.314333, "end": 37.113707, "text": "Draft an email." },
  { "start": 37.422833, "end": 38.399083, "text": "Send a quick message." },
  { "start": 38.708208, "end": 39.413207, "text": "Capture a note." },
  { "start": 39.722375, "end": 40.827625, "text": "Choose a writing style for" },
  { "start": 40.842625, "end": 42.679041, "text": "the moment, with settings that adapt" },
  { "start": 42.694041, "end": 43.599540999999995, "text": "to the way you work." },
  { "start": 46.314333, "end": 48.2215, "text": "Names, technical terms, and the" },
  { "start": 48.2365, "end": 49.472165999999994, "text": "words you use every day." },
  { "start": 49.781333, "end": 51.039916, "text": "Add your vocabulary to the" },
  { "start": 51.054916, "end": 53.551708, "text": "dictionary, and turn spoken shortcuts into" },
  { "start": 53.566708, "end": 55.002832999999995, "text": "the text you repeat most." },
  { "start": 56.313033829365075, "end": 57.27693953081232, "text": "Already have a recording?" },
  {
    "start": 57.58070641923436,
    "end": 59.83554390756302,
    "text": "Import your audio, transcribe it locally,"
  },
  { "start": 59.98812996031746, "end": 61.92893574346405, "text": "and export text or subtitles." },
  {
    "start": 62.23274306722689,
    "end": 64.39454672619047,
    "text": "Give your recordings a useful second life."
  },
  { "start": 65.326125, "end": 66.573582, "text": "Keep ideas in Notes." },
  { "start": 66.929916, "end": 68.63729099999999, "text": "Find past dictations in History." },
  { "start": 68.946416, "end": 70.71208299999999, "text": "Search, pin, and pick up a" },
  { "start": 70.727083, "end": 71.998083, "text": "thought right where you left it." },
  {
    "start": 74.32555040607345,
    "end": 75.90565798022598,
    "text": "Speech recognition and cleanup"
  },
  { "start": 75.92065798022598, "end": 76.91546894420904, "text": "run on your computer." },
  {
    "start": 77.22252986699623,
    "end": 79.85936002824859,
    "text": "Download your models once, then dictate offline."
  },
  { "start": 80.1664199564501, "end": 81.08968722928437, "text": "Your voice deserves a" },
  { "start": 81.10468722928437, "end": 82.4044640242467, "text": "workspace you can trust." },
  { "start": 83.314333, "end": 85.517, "text": "Less friction between thinking and writing." },
  { "start": 85.826125, "end": 87.061791, "text": "More room for your ideas." },
  { "start": 87.370958, "end": 87.863708, "text": "Reflow." },
  { "start": 88.172833, "end": 88.901416, "text": "Speak freely." }
]
